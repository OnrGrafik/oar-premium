// This source code is subject to the Mozilla Public License 2.0
// OAR + NVWAP Levels + VWAP Bands — Birleşik İndikatör

//@version=5
indicator("OAR",
     overlay          = true,
     max_lines_count  = 500,
     max_labels_count = 500,
     max_boxes_count  = 500,
     max_bars_back    = 4800)

// =========================================================
//  YARDIMCI FONKSİYON
// =========================================================
get_size(s) =>
    s == "Tiny" ? size.tiny : s == "Small" ? size.small : s == "Normal" ? size.normal : s == "Large" ? size.large : size.huge

// =========================================================
//  1. SEANS & SILVER BULLET AYARLARI
// =========================================================
grp_1 = "1. Seans Görünüm Ayarları"
s_txt_size = input.string("Small", "Seans Yazı Boyutu", options=["Tiny", "Small", "Normal", "Large", "Huge"], group=grp_1)
s_border_w = input.int(1, "Seans Çizgi Kalınlığı", minval=1, group=grp_1)
max_intraday_tf = input.int(240, "Seans / Fibo / Midnight Maks. Zaman Dilimi (dk)", minval=1, group=grp_1, tooltip="Bu değerin ÜZERİNDEKİ zaman dilimlerinde intraday seviyeler (Seans kutuları, Silver Bullet, Asia Fibonacci ve Midnight / Two / Twao) çizilmez; böylece yüksek zaman dilimlerinde anlamsız seviyeler oluşmaz. Örn: 240 = 4 saat ve altında çizilir, 1G ve üzeri çizilmez.")

c_asia   = input.color(color.red,                   "Asia",        inline="asia",  group=grp_1)
bg_asia  = input.color(color.new(color.red, 95),    "Dolgu",       inline="asia",  group=grp_1)
c_lon_o  = input.color(color.blue,                  "Lon Open",    inline="lon_o", group=grp_1)
bg_lon_o = input.color(color.new(color.blue, 95),   "Dolgu",       inline="lon_o", group=grp_1)
c_ny_o   = input.color(color.green,                 "NY Open",     inline="ny_o",  group=grp_1)
bg_ny_o  = input.color(color.new(color.green, 95),  "Dolgu",       inline="ny_o",  group=grp_1)
c_lon_c  = input.color(color.blue,                  "Lon Close",   inline="lon_c", group=grp_1)
bg_lon_c = input.color(color.new(color.blue, 95),   "Dolgu",       inline="lon_c", group=grp_1)
c_ny_c   = input.color(color.green,                 "NY Close",    inline="ny_c",  group=grp_1)
bg_ny_c  = input.color(color.new(color.green, 95),  "Dolgu",       inline="ny_c",  group=grp_1)
c_cbdr   = input.color(color.orange,                "CBDR",        inline="cbdr",  group=grp_1)
bg_cbdr  = input.color(color.new(color.orange, 95), "Dolgu",       inline="cbdr",  group=grp_1)

grp_sb = "Silver Bullet Ayarları"
show_sb  = input.bool(true, "Silver Bullet Göster", group=grp_sb)
sb_color = input.color(color.new(#9c27b0, 85), "SB Renk", group=grp_sb)

// =========================================================
//  2. KEY LEVELS AYARLARI
// =========================================================
grp_vis = "2. Key Levels Görünürlük"
show_mid = input.bool(true, "Midnight (07:00) Göster", group=grp_vis)
show_do  = input.bool(true, "DO Göster",               group=grp_vis)
show_wo  = input.bool(true, "WO Göster",               group=grp_vis)
show_mo  = input.bool(true, "MO Göster",               group=grp_vis)
show_qo  = input.bool(true, "QO Göster",               group=grp_vis)
show_two = input.bool(true, "Two / Twao Göster",       group=grp_vis)
show_mon = input.bool(true, "Monday Range Göster",     group=grp_vis)
show_pd  = input.bool(true, "Naked PDH / PDL Göster",  group=grp_vis)
show_pw  = input.bool(true, "Naked PWH / PWL Göster",  group=grp_vis)

grp_set = "Key Levels Stil"
color_mid = input.color(color.new(color.gray, 50), "Midnight",   group=grp_set)
color_do  = input.color(color.gray,               "DO Rengi",   group=grp_set)
color_wo  = input.color(color.blue,               "WO Rengi",   group=grp_set)
color_mo  = input.color(color.orange,             "MO Rengi",   group=grp_set)
color_qo  = input.color(#e91e63,                  "QO Rengi",   group=grp_set)
color_two = input.color(#00ff88,                  "Two/Twao",   group=grp_set)
color_mon = input.color(#ffeb3b,                  "Monday Range", group=grp_set)
color_pd  = input.color(#ff5252,                  "PDH / PDL",  group=grp_set)
color_pw  = input.color(#00bcd4,                  "PWH / PWL",  group=grp_set)
kl_txt_sz  = input.string("Small", "Yazı Boyutu", options=["Tiny", "Small", "Normal", "Large"], group=grp_set)
offset_val = input.int(20, "Etiket Mesafesi (mum)", minval=1, group=grp_set)

grp_scale = "Auto-Scale Koruma"
kl_filter_on = input.bool(true, "Uzak Seviyeleri Gizle (grafiği küçültmeyi önler)", group=grp_scale, tooltip="Fiyattan çok uzaktaki seviye ve Fibonacci çizgilerini gizler; böylece indikatör açıldığında grafik otomatik küçülmez. NOT: TradingView'de fiyat ekseni > sağ tık > 'Scale price chart only' seçeneğini de aktif etmeniz kalıcı çözümdür.")
kl_dist_pct  = input.float(30.0, "Maksimum Uzaklık (%)", minval=1.0, step=1.0, group=grp_scale)

// =========================================================
//  3. FİBONACCI AYARLARI
// =========================================================
grp_2 = "3. Fibonacci Ayarları"
show_fibo   = input.bool(true, "Fibonacci Göster", group=grp_2)
f_txt_size  = input.string("Small", "Fibo Yazı Boyutu", options=["Tiny", "Small", "Normal", "Large", "Huge"], group=grp_2)
f_line_w    = input.int(1, "Fibo Çizgi Kalınlığı", minval=1, group=grp_2)
fibo_offset = input.int(10, "Fibo Uzatma (Mum)", group=grp_2)

c_2618  = input.color(#4caf50, "2.618",  group=grp_2)
c_2272  = input.color(#4caf50, "2.272",  group=grp_2)
c_1618  = input.color(#2196f3, "1.618",  group=grp_2)
c_1377  = input.color(color.gray, "1.377", group=grp_2)
c_1000  = input.color(#4caf50, "1.000",  group=grp_2)
c_0500  = input.color(#9c27b0, "0.500",  group=grp_2)
c_0000  = input.color(#4caf50, "0.000",  group=grp_2)
c_m0377 = input.color(color.gray, "-0.377", group=grp_2)
c_m0618 = input.color(#2196f3, "-0.618", group=grp_2)
c_m1272 = input.color(#f44336, "-1.272", group=grp_2)
c_m1618 = input.color(#f44336, "-1.618", group=grp_2)

// =========================================================
//  4. NVWAP AYARLARI
// =========================================================
g0 = "4. NVWAP Genel Ayarları"
dist_filter_pct    = input.float(20.0, "NVWAP Fiyat Filtresi - Max Uzaklık (%)", minval=1.0, maxval=100.0, step=1.0, group=g0)
nvwap_lbl_size_str = input.string("Kucuk", "NVWAP Etiket Boyutu", options=["Cok Kucuk", "Kucuk", "Orta", "Buyuk"], group=g0)
lw_vwap            = input.int(1, "NVWAP Çizgi Kalınlığı", minval=1, maxval=3, group=g0)
nvwap_offset       = input.int(10, "NVWAP Etiket Mesafesi (mum)", minval=1, maxval=200, group=g0)

nvwap_lbl_sz = switch nvwap_lbl_size_str
    "Cok Kucuk" => size.tiny
    "Kucuk"     => size.small
    "Orta"      => size.normal
    => size.large

g1 = "4a. Yıllık NVWAP"
show_year_vwap = input.bool(true, "Önceki Yıl NVWAP (Y)", group=g1)
color_yvwap    = input.color(color.new(#FF0080, 0), "NVWAP(Y) Rengi", group=g1)

g2 = "4b. Çeyreklik NVWAP"
show_quarter_vwap = input.bool(true, "Önceki 2 Çeyrek NVWAP (Q)", group=g2)
color_qvwap       = input.color(color.new(#7B2FBE, 0), "NVWAP(Q) Rengi", group=g2)

g3 = "4c. Aylık NVWAP"
show_month_vwap = input.bool(true, "Mevcut Çeyrek - Aylık NVWAP (M)", group=g3)
color_mvwap     = input.color(color.new(#2EC4B6, 0), "NVWAP(M) Rengi", group=g3)

g4 = "4d. Haftalık NVWAP"
show_week_vwap = input.bool(true, "Mevcut Ay - Haftalık NVWAP (W)", group=g4)
color_wvwap    = input.color(color.new(#F77F00, 0), "NVWAP(W) Rengi", group=g4)

g5 = "4e. Günlük NVWAP"
show_daily_nvwap = input.bool(true, "Son 10 Gün - Günlük NVWAP (D)", group=g5)
color_dvwap      = input.color(color.new(#48CAE4, 0), "NVWAP(D) Rengi", group=g5)

// =========================================================
//  5. VWAP BANTLARI AYARLARI
// =========================================================
grp_vb = "5. VWAP Bantları"

// ── Günlük VWAP Bantları ──
show_dvwap_band  = input.bool(false, "Günlük VWAP Göster",      group=grp_vb, inline="dvwap")
color_dvwap_band = input.color(color.new(#2962FF, 0), "Renk",   group=grp_vb, inline="dvwap")
show_dvwap_b1    = input.bool(false, "Bant 1",                   group=grp_vb, inline="dvwap_b1")
dvwap_b1_mult    = input.float(1.0,  "×",  minval=0.1, step=0.5, group=grp_vb, inline="dvwap_b1")
color_dvwap_b1   = input.color(color.new(color.green, 0), "Renk",group=grp_vb, inline="dvwap_b1")
show_dvwap_b2    = input.bool(false, "Bant 2",                   group=grp_vb, inline="dvwap_b2")
dvwap_b2_mult    = input.float(2.0,  "×",  minval=0.1, step=0.5, group=grp_vb, inline="dvwap_b2")
color_dvwap_b2   = input.color(color.new(color.lime, 0),  "Renk",group=grp_vb, inline="dvwap_b2")

// ── Haftalık VWAP Bantları ──
show_wvwap_band  = input.bool(false, "Haftalık VWAP Göster",     group=grp_vb, inline="wvwap")
color_wvwap_band = input.color(color.new(#FF6D00, 0), "Renk",   group=grp_vb, inline="wvwap")
show_wvwap_b1    = input.bool(false, "Bant 1",                   group=grp_vb, inline="wvwap_b1")
wvwap_b1_mult    = input.float(1.0,  "×",  minval=0.1, step=0.5, group=grp_vb, inline="wvwap_b1")
color_wvwap_b1   = input.color(color.new(color.orange, 0), "Renk", group=grp_vb, inline="wvwap_b1")
show_wvwap_b2    = input.bool(false, "Bant 2",                   group=grp_vb, inline="wvwap_b2")
wvwap_b2_mult    = input.float(2.0,  "×",  minval=0.1, step=0.5, group=grp_vb, inline="wvwap_b2")
color_wvwap_b2   = input.color(color.new(#FF9800, 0), "Renk",   group=grp_vb, inline="wvwap_b2")

// ── Aylık VWAP Bantları ──
show_mvwap_band  = input.bool(false, "Aylık VWAP Göster",        group=grp_vb, inline="mvwap")
color_mvwap_band = input.color(color.new(#AA00FF, 0), "Renk",   group=grp_vb, inline="mvwap")
show_mvwap_b1    = input.bool(false, "Bant 1",                   group=grp_vb, inline="mvwap_b1")
mvwap_b1_mult    = input.float(1.0,  "×",  minval=0.1, step=0.5, group=grp_vb, inline="mvwap_b1")
color_mvwap_b1   = input.color(color.new(#CE93D8, 0), "Renk",   group=grp_vb, inline="mvwap_b1")
show_mvwap_b2    = input.bool(false, "Bant 2",                   group=grp_vb, inline="mvwap_b2")
mvwap_b2_mult    = input.float(2.0,  "×",  minval=0.1, step=0.5, group=grp_vb, inline="mvwap_b2")
color_mvwap_b2   = input.color(color.new(#E1BEE7, 0), "Renk",   group=grp_vb, inline="mvwap_b2")

// ── Dolgu (Fill) Renk Ayarları ──
color_dfill_b1 = input.color(color.new(color.green, 0), "Günlük B1 Dolgu",  group=grp_vb, inline="dfill")
color_dfill_b2 = input.color(color.new(color.lime, 0),  "B2 Dolgu",         group=grp_vb, inline="dfill")
color_wfill_b1 = input.color(color.new(color.orange, 0),"Haftalık B1 Dolgu",group=grp_vb, inline="wfill")
color_wfill_b2 = input.color(color.new(#FF9800, 0),     "B2 Dolgu",         group=grp_vb, inline="wfill")
color_mfill_b1 = input.color(color.new(#CE93D8, 0),     "Aylık B1 Dolgu",   group=grp_vb, inline="mfill")
color_mfill_b2 = input.color(color.new(#E1BEE7, 0),     "B2 Dolgu",         group=grp_vb, inline="mfill")
vwap_fill_transp = input.int(92, "Dolgu Şeffaflığı", minval=50, maxval=99, group=grp_vb)

// =========================================================
//  ZAMAN KONTROLLERİ
// =========================================================
get_in_sess(sess) => not na(time(timeframe.period, sess, "GMT+3"))

is_asia  = get_in_sess("0300-0700")
is_lon_o = get_in_sess("0900-1200")
is_ny_o  = get_in_sess("1400-1700")
is_lon_c = get_in_sess("1700-1900")
is_ny_c  = get_in_sess("2030-2300")
is_cbdr  = get_in_sess("2300-0300")

is_sb1 = get_in_sess("1000-1100")
is_sb2 = get_in_sess("1700-1800")
is_sb3 = get_in_sess("2100-2200")

is_0700          = (hour(time, "GMT+3") == 7 and minute(time, "GMT+3") == 0)
is_new_day_tr    = ta.change(time("D", "GMT+3"))
is_new_month_tr  = ta.change(time("M", "GMT+3"))
is_new_quarter_tr = is_new_month_tr and (month(time, "GMT+3") == 1 or month(time, "GMT+3") == 4 or month(time, "GMT+3") == 7 or month(time, "GMT+3") == 10)

tr_day       = dayofweek(time, "GMT+3")
// Yıl sınırında sıfırlanmayan, monoton artan hafta kimliği (eski Two/Twao/Midnight temizliği için)
current_week = year(time, "GMT+3") * 53 + weekofyear(time, "GMT+3")
// Referans "şimdi": canlıda son bar, Bar Replay'de replay imleci. Böylece geçmişe/replay'e
// alındığında da (timenow gerçek zamanı kullanmak yerine) o günkü seviyeler çizilir.
_ref_now     = last_bar_time
is_recent    = (_ref_now - time) < (3 * 24 * 60 * 60 * 1000)
// Intraday seviyeleri sadece seçilen zaman dilimi ve altında çiz (yüksek TF'de anlamsız seviye olmasın)
tf_ok        = timeframe.in_seconds() <= max_intraday_tf * 60

bgcolor(show_sb and tf_ok and is_recent and (is_sb1 or is_sb2 or is_sb3) ? sb_color : na)

// =========================================================
//  SEANS KUTU FONKSİYONU
// =========================================================
draw_projected_box(cond, txt, b_clr, f_clr, end_h, end_m) =>
    var box   b = na
    var label l = na
    if cond and not cond[1] and is_recent
        t_end = timestamp("GMT+3", year, month, dayofmonth, end_h, end_m, 0)
        if t_end < time
            t_end := timestamp("GMT+3", year, month, dayofmonth + 1, end_h, end_m, 0)
        milis_per_bar = timeframe.in_seconds() * 1000
        bars_to_end   = math.round((t_end - time) / milis_per_bar)
        b := box.new(bar_index, high, bar_index + bars_to_end, low,
             border_color=b_clr, border_width=s_border_w, border_style=line.style_dotted, bgcolor=f_clr)
        l := label.new(bar_index, high, txt,
             style=label.style_none, textcolor=b_clr, size=get_size(s_txt_size), textalign=text.align_center)
    if cond and not na(b)
        box.set_top(b, math.max(box.get_top(b), high))
        box.set_bottom(b, math.min(box.get_bottom(b), low))
        label.set_xy(l, math.round((box.get_left(b) + box.get_right(b)) / 2), box.get_top(b))
    true

draw_projected_box(is_asia  and tf_ok, "Asia",         c_asia,  bg_asia,   7, 0)
draw_projected_box(is_lon_o and tf_ok, "London Open",  c_lon_o, bg_lon_o, 12, 0)
draw_projected_box(is_ny_o  and tf_ok, "NY Open",      c_ny_o,  bg_ny_o,  17, 0)
draw_projected_box(is_lon_c and tf_ok, "London Close", c_lon_c, bg_lon_c, 19, 0)
draw_projected_box(is_ny_c  and tf_ok, "NY Close",     c_ny_c,  bg_ny_c,  23, 0)
draw_projected_box(is_cbdr  and tf_ok, "CBDR",         c_cbdr,  bg_cbdr,   3, 0)

// =========================================================
//  KEY LEVELS SİSTEMİ
// =========================================================
pdh_val = request.security(syminfo.tickerid, "D",  high[1], lookahead=barmerge.lookahead_on)
pdl_val = request.security(syminfo.tickerid, "D",  low[1],  lookahead=barmerge.lookahead_on)
pwh_val = request.security(syminfo.tickerid, "W",  high[1], lookahead=barmerge.lookahead_on)
pwl_val = request.security(syminfo.tickerid, "W",  low[1],  lookahead=barmerge.lookahead_on)
do_val  = request.security(syminfo.tickerid, "D",  open,    lookahead=barmerge.lookahead_on)
wo_val  = request.security(syminfo.tickerid, "W",  open,    lookahead=barmerge.lookahead_on)
mo_val  = request.security(syminfo.tickerid, "M",  open,    lookahead=barmerge.lookahead_on)
qo_val  = request.security(syminfo.tickerid, "3M", open,    lookahead=barmerge.lookahead_on)

var line[]   all_lines  = array.new_line()
var label[]  all_labels = array.new_label()
var float[]  all_prices = array.new_float()
var string[] all_names  = array.new_string()
var int[]    level_type = array.new_int()
var int[]    week_tags  = array.new_int()
var int[]    time_tags  = array.new_int()

add_level(price, name, ltype, clr) =>
    l  = line.new(bar_index, price, bar_index, price, color=clr, style=line.style_dotted)
    lb = label.new(bar_index, price, name, color=#00000000, textcolor=clr, style=label.style_label_left, size=get_size(kl_txt_sz))
    array.push(all_lines, l), array.push(all_labels, lb)
    array.push(all_prices, price), array.push(all_names, name)
    array.push(level_type, ltype), array.push(week_tags, current_week), array.push(time_tags, time)

if is_0700 and tf_ok
    if array.size(level_type) > 0
        for i = array.size(level_type) - 1 to 0
            if array.get(level_type, i) == 0
                line.delete(array.remove(all_lines, i)), label.delete(array.remove(all_labels, i))
                array.remove(all_prices, i), array.remove(all_names, i), array.remove(level_type, i), array.remove(week_tags, i), array.remove(time_tags, i)
    if show_mid
        string m_name  = "Midnight"
        color  m_color = color_mid
        int    m_type  = 0
        if tr_day == dayofweek.monday and show_two
            m_name := "Two/Midnight",  m_color := color_two, m_type := 1
        else if tr_day == dayofweek.tuesday and show_two
            m_name := "Twao/Midnight", m_color := color_two, m_type := 11
        add_level(open, m_name, m_type, m_color)

if is_new_day_tr
    if show_do
        if array.size(level_type) > 0
            for i = array.size(level_type) - 1 to 0
                if array.get(level_type, i) == 4
                    line.delete(array.remove(all_lines, i)), label.delete(array.remove(all_labels, i))
                    array.remove(all_prices, i), array.remove(all_names, i), array.remove(level_type, i), array.remove(week_tags, i), array.remove(time_tags, i)
        add_level(do_val, "DO", 4, color_do)

    if show_wo and tr_day == dayofweek.monday
        if array.size(level_type) > 0
            for i = array.size(level_type) - 1 to 0
                if array.get(level_type, i) == 5
                    line.delete(array.remove(all_lines, i)), label.delete(array.remove(all_labels, i))
                    array.remove(all_prices, i), array.remove(all_names, i), array.remove(level_type, i), array.remove(week_tags, i), array.remove(time_tags, i)
        add_level(wo_val, "WO", 5, color_wo)

    if show_mo and is_new_month_tr
        if array.size(level_type) > 0
            for i = array.size(level_type) - 1 to 0
                if array.get(level_type, i) == 6
                    line.delete(array.remove(all_lines, i)), label.delete(array.remove(all_labels, i))
                    array.remove(all_prices, i), array.remove(all_names, i), array.remove(level_type, i), array.remove(week_tags, i), array.remove(time_tags, i)
        add_level(mo_val, "MO", 6, color_mo)

    if show_qo and is_new_quarter_tr
        if array.size(level_type) > 0
            for i = array.size(level_type) - 1 to 0
                if array.get(level_type, i) == 7
                    line.delete(array.remove(all_lines, i)), label.delete(array.remove(all_labels, i))
                    array.remove(all_prices, i), array.remove(all_names, i), array.remove(level_type, i), array.remove(week_tags, i), array.remove(time_tags, i)
        add_level(qo_val, "QO", 7, color_qo)

    if show_pd
        add_level(pdh_val, "PDH", 2, color_pd)
        add_level(pdl_val, "PDL", 2, color_pd)

    if show_pw and tr_day == dayofweek.monday
        add_level(pwh_val, "PWH", 3, color_pw)
        add_level(pwl_val, "PWL", 3, color_pw)

if array.size(all_prices) > 0
    for i = array.size(all_prices) - 1 to 0
        p  = array.get(all_prices, i)
        t  = array.get(level_type, i)
        w  = array.get(week_tags, i)
        ts = array.get(time_tags, i)
        l  = array.get(all_lines, i)
        lb = array.get(all_labels, i)

        is_old_week   = (w < current_week)
        is_pd_expired = (t == 2 and (_ref_now - ts) > (28 * 24 * 60 * 60 * 1000))
        is_pw_expired = (t == 3 and (_ref_now - ts) > (56 * 24 * 60 * 60 * 1000))
        bool is_hit   = false
        if (t == 2 or t == 3) and barstate.isconfirmed
            if high >= p and low <= p
                is_hit := true

        string current_name = array.get(all_names, i)
        if t == 1 and (tr_day != dayofweek.monday or is_new_day_tr)
            current_name := "Two"
            array.set(all_names, i, current_name)
        if t == 11 and (tr_day != dayofweek.tuesday or is_new_day_tr)
            current_name := "Twao"
            array.set(all_names, i, current_name)

        if is_old_week and (t == 0 or t == 1 or t == 11) or is_pd_expired or is_pw_expired or is_hit
            line.delete(array.remove(all_lines, i)), label.delete(array.remove(all_labels, i))
            array.remove(all_prices, i), array.remove(all_names, i), array.remove(level_type, i), array.remove(week_tags, i), array.remove(time_tags, i)
        else
            string final_txt = current_name
            clr = t == 0 ? color_mid : (t == 1 or t == 11) ? color_two : t == 4 ? color_do : t == 5 ? color_wo : t == 6 ? color_mo : t == 7 ? color_qo : t == 2 ? color_pd : color_pw
            label.set_textcolor(lb, clr)

            for j = 0 to array.size(all_prices) - 1
                if i != j and math.abs(p - array.get(all_prices, j)) / p < 0.0001
                    if i > j
                        final_txt := array.get(all_names, j) + " / " + final_txt
                        label.set_textcolor(array.get(all_labels, j), color.new(color.white, 100))

            label.set_text(lb, final_txt)

            // Auto-scale koruma: fiyattan çok uzak seviyeleri gizle (çizgiyi na yaparak ölçeğe dahil etme)
            bool kl_far = kl_filter_on and (math.abs(p - close) / close > kl_dist_pct / 100.0)
            if kl_far
                line.set_y1(l, na), line.set_y2(l, na)
                label.set_y(lb, na)
            else
                line.set_y1(l, p),  line.set_y2(l, p)
                label.set_y(lb, p)
                line.set_x2(l, bar_index + offset_val - 5)
                label.set_x(lb, bar_index + offset_val)

// Monday Range
var float m_h = na, var float m_l = na, var int m_idx = na
var line ln_h = na, var line ln_l = na, var line ln_eq = na
var label lbm_h = na, var label lbm_l = na, var label lbm_eq = na

if show_mon
    if tr_day == dayofweek.monday and is_new_day_tr
        line.delete(ln_h), line.delete(ln_l), line.delete(ln_eq)
        label.delete(lbm_h), label.delete(lbm_l), label.delete(lbm_eq)
        m_h := high, m_l := low, m_idx := bar_index
        ln_h  := line.new(m_idx, m_h, bar_index, m_h, color=color_mon, style=line.style_dotted)
        lbm_h := label.new(bar_index, m_h, "Monday-H", color=#00000000, textcolor=color_mon, style=label.style_label_left, size=get_size(kl_txt_sz))
        ln_l  := line.new(m_idx, m_l, bar_index, m_l, color=color_mon, style=line.style_dotted)
        lbm_l := label.new(bar_index, m_l, "Monday-L", color=#00000000, textcolor=color_mon, style=label.style_label_left, size=get_size(kl_txt_sz))
        ln_eq  := line.new(m_idx, (m_h+m_l)/2, bar_index, (m_h+m_l)/2, color=color_mon, style=line.style_dotted)
        lbm_eq := label.new(bar_index, (m_h+m_l)/2, "Monday-EQ", color=#00000000, textcolor=color_mon, style=label.style_label_left, size=get_size(kl_txt_sz))
    if tr_day == dayofweek.monday
        m_h := math.max(m_h, high), m_l := math.min(m_l, low)
        m_eq = (m_h + m_l) / 2
        line.set_xy1(ln_h, m_idx, m_h),  line.set_xy2(ln_h, bar_index, m_h),  label.set_xy(lbm_h, bar_index, m_h)
        line.set_xy1(ln_l, m_idx, m_l),  line.set_xy2(ln_l, bar_index, m_l),  label.set_xy(lbm_l, bar_index, m_l)
        line.set_xy1(ln_eq, m_idx, m_eq), line.set_xy2(ln_eq, bar_index, m_eq), label.set_xy(lbm_eq, bar_index, m_eq)

if show_mon and not na(ln_h)
    float m_eq_cur  = (m_h + m_l) / 2
    bool mon_h_far  = kl_filter_on and (math.abs(m_h - close)     / close > kl_dist_pct / 100.0)
    bool mon_l_far  = kl_filter_on and (math.abs(m_l - close)     / close > kl_dist_pct / 100.0)
    bool mon_eq_far = kl_filter_on and (math.abs(m_eq_cur - close) / close > kl_dist_pct / 100.0)
    if mon_h_far
        line.set_y1(ln_h, na), line.set_y2(ln_h, na), label.set_y(lbm_h, na)
    else
        line.set_y1(ln_h, m_h), line.set_y2(ln_h, m_h), label.set_y(lbm_h, m_h)
        line.set_x2(ln_h, bar_index + offset_val - 5),  label.set_x(lbm_h, bar_index + offset_val)
    if mon_l_far
        line.set_y1(ln_l, na), line.set_y2(ln_l, na), label.set_y(lbm_l, na)
    else
        line.set_y1(ln_l, m_l), line.set_y2(ln_l, m_l), label.set_y(lbm_l, m_l)
        line.set_x2(ln_l, bar_index + offset_val - 5),  label.set_x(lbm_l, bar_index + offset_val)
    if mon_eq_far
        line.set_y1(ln_eq, na), line.set_y2(ln_eq, na), label.set_y(lbm_eq, na)
    else
        line.set_y1(ln_eq, m_eq_cur), line.set_y2(ln_eq, m_eq_cur), label.set_y(lbm_eq, m_eq_cur)
        line.set_x2(ln_eq, bar_index + offset_val - 5), label.set_x(lbm_eq, bar_index + offset_val)

// =========================================================
//  FİBONACCI (ASIA RANGE)
// =========================================================
var int    a_st = na
var float  a_h  = na
var float  a_l  = na
var line[]  f_lns = array.new_line()
var label[] f_lbs = array.new_label()

if is_asia
    if not is_asia[1]
        a_st := bar_index, a_h := high, a_l := low
    else
        a_h := math.max(high, a_h), a_l := math.min(low, a_l)

if not na(a_h) and not na(a_st) and is_recent and tf_ok
    if array.size(f_lns) > 0
        for i = 0 to array.size(f_lns) - 1
            line.delete(array.get(f_lns, i)), label.delete(array.get(f_lbs, i))
    array.clear(f_lns), array.clear(f_lbs)
    if show_fibo
        r    = a_h - a_l
        lvls = array.from(2.618, 2.272, 1.618, 1.377, 1.0, 0.5, 0.0, -0.377, -0.618, -1.272, -1.618)
        clrs = array.from(c_2618, c_2272, c_1618, c_1377, c_1000, c_0500, c_0000, c_m0377, c_m0618, c_m1272, c_m1618)
        for i = 0 to array.size(lvls) - 1
            v  = array.get(lvls, i)
            c  = array.get(clrs, i)
            p  = a_l + (r * v)
            if not (kl_filter_on and (math.abs(p - close) / close > kl_dist_pct / 100.0))
                ln = line.new(a_st, p, bar_index + fibo_offset, p, color=c, width=f_line_w)
                lfb = label.new(bar_index + fibo_offset, p,
                     str.tostring(v) + " (" + str.tostring(p, "#.#") + ")",
                     style=label.style_label_left, color=#ffffff00, textcolor=c, size=get_size(f_txt_size))
                array.push(f_lns, ln), array.push(f_lbs, lfb)

// =========================================================
//  VWAP BANTLARI — HESAPLAMA (TR Saati Çapalı)
// =========================================================
// TR saat bazlı çapa koşulları:
// Günlük  → Her gün 03:00 TR (Asia açılışı)
// Haftalık → Pazartesi 03:00 TR
// Aylık    → Ayın 1. günü 03:00 TR

_tr_hour   = hour(time, "GMT+3")
_tr_min    = minute(time, "GMT+3")
_tr_dow    = dayofweek(time, "GMT+3")
_tr_dom    = dayofmonth(time, "GMT+3")

// Günlük çapa: her gün 03:00 TR
_is_d_anchor = (_tr_hour == 3 and _tr_min == 0)

// Haftalık çapa: Pazartesi 03:00 TR
_is_w_anchor = (_tr_dow == dayofweek.monday and _tr_hour == 3 and _tr_min == 0)

// Aylık çapa: Ayın 1. günü 03:00 TR
_is_m_anchor = (_tr_dom == 1 and _tr_hour == 3 and _tr_min == 0)

// ── VWAP Bantları: Sadece mevcut periyotta göster ────────────
// timenow kullanılarak "gerçek şimdiki zaman" referansıyla
// bugünün/bu haftanın/bu ayın başlangıç zamanı hesaplanır.
// Tarihsel barlar bu zamanın gerisinde kaldığı için na döner.

// Günlük: bugünün TR 03:00'ı (referans zaman bazlı — canlıda son bar, replay'de imleç)
_now_d_year   = year(_ref_now,  "GMT+3")
_now_d_month  = month(_ref_now, "GMT+3")
_now_d_day    = dayofmonth(_ref_now, "GMT+3")
_now_d_hour   = hour(_ref_now, "GMT+3")
// Eğer şu an 03:00'dan önceyse, periyot dünün 03:00'ından başlar
_d_start_day  = _now_d_hour < 3 ? _now_d_day - 1 : _now_d_day
_d_start_ts   = timestamp("GMT+3", _now_d_year, _now_d_month, _d_start_day, 3, 0, 0)
_d_show       = time >= _d_start_ts

// Haftalık: bu haftanın Pazartesi TR 03:00'ı (referans zaman bazlı)
_now_w_dow    = dayofweek(_ref_now, "GMT+3")
_days_to_mon  = _now_w_dow == dayofweek.sunday ? 6 : _now_w_dow - dayofweek.monday
_w_start_ts   = timestamp("GMT+3", _now_d_year, _now_d_month, _now_d_day - _days_to_mon, 3, 0, 0)
_w_show       = time >= _w_start_ts

// Aylık: bu ayın 1. günü TR 03:00'ı (referans zaman bazlı)
_m_start_ts   = timestamp("GMT+3", _now_d_year, _now_d_month, 1, 3, 0, 0)
_m_show       = time >= _m_start_ts

// Günlük VWAP (TR 03:00 çapalı — sadece bugünden itibaren)
[vwap_d_raw, vwap_d_u1_raw, vwap_d_l1_raw] = ta.vwap(hlc3, _is_d_anchor, 1)
vwap_d_stdev   = vwap_d_u1_raw - vwap_d_raw
vwap_d_val     = _d_show ? vwap_d_raw : na
vwap_d_upper1r = _d_show ? vwap_d_raw + vwap_d_stdev * dvwap_b1_mult : na
vwap_d_lower1r = _d_show ? vwap_d_raw - vwap_d_stdev * dvwap_b1_mult : na
vwap_d_upper2  = _d_show ? vwap_d_raw + vwap_d_stdev * dvwap_b2_mult : na
vwap_d_lower2  = _d_show ? vwap_d_raw - vwap_d_stdev * dvwap_b2_mult : na

// Haftalık VWAP (Pazartesi TR 03:00 çapalı — sadece bu haftadan itibaren)
[vwap_w_raw, vwap_w_u1_raw, vwap_w_l1_raw] = ta.vwap(hlc3, _is_w_anchor, 1)
vwap_w_stdev   = vwap_w_u1_raw - vwap_w_raw
vwap_w_val     = _w_show ? vwap_w_raw : na
vwap_w_upper1r = _w_show ? vwap_w_raw + vwap_w_stdev * wvwap_b1_mult : na
vwap_w_lower1r = _w_show ? vwap_w_raw - vwap_w_stdev * wvwap_b1_mult : na
vwap_w_upper2  = _w_show ? vwap_w_raw + vwap_w_stdev * wvwap_b2_mult : na
vwap_w_lower2  = _w_show ? vwap_w_raw - vwap_w_stdev * wvwap_b2_mult : na

// Aylık VWAP (Ayın 1. günü TR 03:00 çapalı — sadece bu aydan itibaren)
[vwap_m_raw, vwap_m_u1_raw, vwap_m_l1_raw] = ta.vwap(hlc3, _is_m_anchor, 1)
vwap_m_stdev   = vwap_m_u1_raw - vwap_m_raw
vwap_m_val     = _m_show ? vwap_m_raw : na
vwap_m_upper1r = _m_show ? vwap_m_raw + vwap_m_stdev * mvwap_b1_mult : na
vwap_m_lower1r = _m_show ? vwap_m_raw - vwap_m_stdev * mvwap_b1_mult : na
vwap_m_upper2  = _m_show ? vwap_m_raw + vwap_m_stdev * mvwap_b2_mult : na
vwap_m_lower2  = _m_show ? vwap_m_raw - vwap_m_stdev * mvwap_b2_mult : na

// =========================================================
//  VWAP BANTLARI — ÇİZİM
// =========================================================

// ── Günlük VWAP ──
p_dvwap    = plot(show_dvwap_band ? vwap_d_val    : na, "VWAP (D)",      color=color_dvwap_band, linewidth=2)
p_dvwap_u1 = plot(show_dvwap_band and show_dvwap_b1 ? vwap_d_upper1r : na, "VWAP D Üst B1", color=color_dvwap_b1, linewidth=1)
p_dvwap_l1 = plot(show_dvwap_band and show_dvwap_b1 ? vwap_d_lower1r : na, "VWAP D Alt B1", color=color_dvwap_b1, linewidth=1)
p_dvwap_u2 = plot(show_dvwap_band and show_dvwap_b2 ? vwap_d_upper2  : na, "VWAP D Üst B2", color=color_dvwap_b2, linewidth=1)
p_dvwap_l2 = plot(show_dvwap_band and show_dvwap_b2 ? vwap_d_lower2  : na, "VWAP D Alt B2", color=color_dvwap_b2, linewidth=1)
fill(p_dvwap_u1, p_dvwap_l1, color=show_dvwap_band and show_dvwap_b1 ? color.new(color_dfill_b1, vwap_fill_transp) : na, title="VWAP D Bant 1 Dolgu")
fill(p_dvwap_u2, p_dvwap_l2, color=show_dvwap_band and show_dvwap_b2 ? color.new(color_dfill_b2, vwap_fill_transp) : na, title="VWAP D Bant 2 Dolgu")

// ── Haftalık VWAP ──
p_wvwap    = plot(show_wvwap_band ? vwap_w_val    : na, "VWAP (W)",      color=color_wvwap_band, linewidth=2)
p_wvwap_u1 = plot(show_wvwap_band and show_wvwap_b1 ? vwap_w_upper1r : na, "VWAP W Üst B1", color=color_wvwap_b1, linewidth=1)
p_wvwap_l1 = plot(show_wvwap_band and show_wvwap_b1 ? vwap_w_lower1r : na, "VWAP W Alt B1", color=color_wvwap_b1, linewidth=1)
p_wvwap_u2 = plot(show_wvwap_band and show_wvwap_b2 ? vwap_w_upper2  : na, "VWAP W Üst B2", color=color_wvwap_b2, linewidth=1)
p_wvwap_l2 = plot(show_wvwap_band and show_wvwap_b2 ? vwap_w_lower2  : na, "VWAP W Alt B2", color=color_wvwap_b2, linewidth=1)
fill(p_wvwap_u1, p_wvwap_l1, color=show_wvwap_band and show_wvwap_b1 ? color.new(color_wfill_b1, vwap_fill_transp) : na, title="VWAP W Bant 1 Dolgu")
fill(p_wvwap_u2, p_wvwap_l2, color=show_wvwap_band and show_wvwap_b2 ? color.new(color_wfill_b2, vwap_fill_transp) : na, title="VWAP W Bant 2 Dolgu")

// ── Aylık VWAP ──
p_mvwap    = plot(show_mvwap_band ? vwap_m_val    : na, "VWAP (M)",      color=color_mvwap_band, linewidth=2)
p_mvwap_u1 = plot(show_mvwap_band and show_mvwap_b1 ? vwap_m_upper1r : na, "VWAP M Üst B1", color=color_mvwap_b1, linewidth=1)
p_mvwap_l1 = plot(show_mvwap_band and show_mvwap_b1 ? vwap_m_lower1r : na, "VWAP M Alt B1", color=color_mvwap_b1, linewidth=1)
p_mvwap_u2 = plot(show_mvwap_band and show_mvwap_b2 ? vwap_m_upper2  : na, "VWAP M Üst B2", color=color_mvwap_b2, linewidth=1)
p_mvwap_l2 = plot(show_mvwap_band and show_mvwap_b2 ? vwap_m_lower2  : na, "VWAP M Alt B2", color=color_mvwap_b2, linewidth=1)
fill(p_mvwap_u1, p_mvwap_l1, color=show_mvwap_band and show_mvwap_b1 ? color.new(color_mfill_b1, vwap_fill_transp) : na, title="VWAP M Bant 1 Dolgu")
fill(p_mvwap_u2, p_mvwap_l2, color=show_mvwap_band and show_mvwap_b2 ? color.new(color_mfill_b2, vwap_fill_transp) : na, title="VWAP M Bant 2 Dolgu")

// =========================================================
//  NVWAP — HESAPLAMA
// =========================================================
has_volume = ta.cum(volume) > 0

anchor_y = timeframe.change("12M")
anchor_q = timeframe.change("3M")
anchor_m = timeframe.change("M")
anchor_w = timeframe.change("W")
anchor_d = timeframe.change("D")

vwap_y = ta.vwap(hlc3, anchor_y)
vwap_q = ta.vwap(hlc3, anchor_q)
vwap_m = ta.vwap(hlc3, anchor_m)
vwap_w = ta.vwap(hlc3, anchor_w)
vwap_d = ta.vwap(hlc3, anchor_d)

is_new_year_v    = anchor_y
is_new_quarter_v = anchor_q
is_new_month_v   = anchor_m
is_new_week_v    = anchor_w
is_new_day_v     = anchor_d

// =========================================================
//  NVWAP — KAPALI SEVİYE SAKLAMA
// =========================================================
var float   closed_vwap_year    = na
var bool    closed_year_touched = false

var float[] closed_vwap_qlist = array.new_float()
var bool[]  closed_q_touched  = array.new_bool()

var float[] closed_vwap_mlist = array.new_float()
var bool[]  closed_m_touched  = array.new_bool()

var float[] closed_vwap_wlist = array.new_float()
var bool[]  closed_w_touched  = array.new_bool()

var float[] closed_vwap_dlist = array.new_float()
var bool[]  closed_d_touched  = array.new_bool()

if is_new_year_v and has_volume
    closed_vwap_year    := vwap_y[1]
    closed_year_touched := false
    array.unshift(closed_vwap_qlist, vwap_q[1])
    array.unshift(closed_q_touched,  false)
    if array.size(closed_vwap_qlist) > 2
        array.pop(closed_vwap_qlist), array.pop(closed_q_touched)
    array.clear(closed_vwap_mlist), array.clear(closed_m_touched)
    array.clear(closed_vwap_wlist), array.clear(closed_w_touched)

if is_new_quarter_v and not is_new_year_v and has_volume
    array.unshift(closed_vwap_qlist, vwap_q[1])
    array.unshift(closed_q_touched,  false)
    if array.size(closed_vwap_qlist) > 2
        array.pop(closed_vwap_qlist), array.pop(closed_q_touched)
    array.clear(closed_vwap_mlist), array.clear(closed_m_touched)
    array.clear(closed_vwap_wlist), array.clear(closed_w_touched)

if is_new_month_v and not is_new_quarter_v and not is_new_year_v and has_volume
    array.unshift(closed_vwap_mlist, vwap_m[1])
    array.unshift(closed_m_touched,  false)
    if array.size(closed_vwap_mlist) > 4
        array.pop(closed_vwap_mlist), array.pop(closed_m_touched)
    array.clear(closed_vwap_wlist), array.clear(closed_w_touched)

if is_new_week_v and not is_new_month_v and not is_new_quarter_v and not is_new_year_v and has_volume
    array.unshift(closed_vwap_wlist, vwap_w[1])
    array.unshift(closed_w_touched,  false)
    if array.size(closed_vwap_wlist) > 6
        array.pop(closed_vwap_wlist), array.pop(closed_w_touched)

if is_new_day_v and has_volume
    array.unshift(closed_vwap_dlist, vwap_d[1])
    array.unshift(closed_d_touched,  false)
    if array.size(closed_vwap_dlist) > 12
        array.pop(closed_vwap_dlist), array.pop(closed_d_touched)

// =========================================================
//  NVWAP — TOUCHED GÜNCELLEME
// =========================================================
if not na(closed_vwap_year) and not closed_year_touched
    if low <= closed_vwap_year and high >= closed_vwap_year
        closed_year_touched := true

_qsz = array.size(closed_vwap_qlist)
if _qsz > 0
    for _i = 0 to _qsz - 1
        if not array.get(closed_q_touched, _i)
            float _v = array.get(closed_vwap_qlist, _i)
            if low <= _v and high >= _v
                array.set(closed_q_touched, _i, true)

_msz = array.size(closed_vwap_mlist)
if _msz > 0
    for _i = 0 to _msz - 1
        if not array.get(closed_m_touched, _i)
            float _v = array.get(closed_vwap_mlist, _i)
            if low <= _v and high >= _v
                array.set(closed_m_touched, _i, true)

_wsz = array.size(closed_vwap_wlist)
if _wsz > 0
    for _i = 0 to _wsz - 1
        if not array.get(closed_w_touched, _i)
            float _v = array.get(closed_vwap_wlist, _i)
            if low <= _v and high >= _v
                array.set(closed_w_touched, _i, true)

_dsz = array.size(closed_vwap_dlist)
if _dsz > 0
    for _i = 0 to _dsz - 1
        if not array.get(closed_d_touched, _i)
            float _v = array.get(closed_vwap_dlist, _i)
            if low <= _v and high >= _v
                array.set(closed_d_touched, _i, true)

// =========================================================
//  NVWAP — ÇİZİM
// =========================================================
is_too_far(float lvl) =>
    math.abs(lvl - close) / close * 100.0 > dist_filter_pct

var line[]  nvwap_lines  = array.new_line()
var label[] nvwap_labels = array.new_label()

draw_nvwap(float price, string lbl, color clr) =>
    if not na(price) and not is_too_far(price)
        _l  = line.new(bar_index, price, bar_index + nvwap_offset, price,
              color=clr, width=lw_vwap, style=line.style_dashed, extend=extend.none)
        _lb = label.new(bar_index + nvwap_offset, price, lbl,
              color=color.new(color.black, 100), textcolor=clr,
              style=label.style_label_left, size=nvwap_lbl_sz)
        array.push(nvwap_lines,  _l)
        array.push(nvwap_labels, _lb)

if barstate.islast
    int _nl = array.size(nvwap_lines)
    if _nl > 0
        for _i = 0 to _nl - 1
            line.delete(array.get(nvwap_lines, _i))
    int _nla = array.size(nvwap_labels)
    if _nla > 0
        for _i = 0 to _nla - 1
            label.delete(array.get(nvwap_labels, _i))
    array.clear(nvwap_lines)
    array.clear(nvwap_labels)

    if not has_volume
        label.new(bar_index, close, "Volume verisi yok.",
             color=color.red, textcolor=color.white,
             style=label.style_label_left, size=size.normal)
    else
        if show_year_vwap and not na(closed_vwap_year) and not closed_year_touched
            draw_nvwap(closed_vwap_year, "* NVWAP (Y)", color_yvwap)

        if show_quarter_vwap
            int _qsz2 = array.size(closed_vwap_qlist)
            if _qsz2 > 0
                for _i = 0 to _qsz2 - 1
                    if not array.get(closed_q_touched, _i)
                        float _v = array.get(closed_vwap_qlist, _i)
                        if not na(_v)
                            draw_nvwap(_v, "* NVWAP (Q)", color_qvwap)

        if show_month_vwap
            int _msz2 = array.size(closed_vwap_mlist)
            if _msz2 > 0
                for _i = 0 to _msz2 - 1
                    if not array.get(closed_m_touched, _i)
                        float _v = array.get(closed_vwap_mlist, _i)
                        if not na(_v)
                            draw_nvwap(_v, "* NVWAP (M)", color_mvwap)

        if show_week_vwap
            int _wsz2 = array.size(closed_vwap_wlist)
            if _wsz2 > 0
                for _i = 0 to _wsz2 - 1
                    if not array.get(closed_w_touched, _i)
                        float _v = array.get(closed_vwap_wlist, _i)
                        if not na(_v)
                            draw_nvwap(_v, "* NVWAP (W)", color_wvwap)

        if show_daily_nvwap
            int _dsz2 = array.size(closed_vwap_dlist)
            if _dsz2 > 0
                int _lim = math.min(10, _dsz2)
                for _i = 0 to _lim - 1
                    if not array.get(closed_d_touched, _i)
                        float _v = array.get(closed_vwap_dlist, _i)
                        if not na(_v)
                            draw_nvwap(_v, "* NVWAP (D)", color_dvwap)
